# ==================== 模板配置 ====================
# 复制本文件为 application-local.properties（已被 .gitignore 忽略），
# 填入真实密码 / API Key 后即可本地运行。

server.port=8088
server.servlet.context-path=/student9/api

spring.application.name=resume-system

# ==================== 数据库 ====================
spring.datasource.url=jdbc:mysql://localhost:3306/resume_db?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=<YOUR_DB_PASSWORD>
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ==================== 文件上传 ====================
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
spring.servlet.multipart.enabled=true

# ==================== MyBatis ====================
mybatis.mapper-locations=classpath:mapper/*.xml
mybatis.type-aliases-package=com.jianlidb.resume.model.entity
mybatis.configuration.map-underscore-to-camel-case=true

# ==================== CORS ====================
spring.web.cors.allowed-origins=*
spring.web.cors.allowed-methods=GET,POST,PUT,DELETE,OPTIONS
spring.web.cors.allowed-headers=*
spring.web.cors.allow-credentials=true

# ==================== 应用 URL ====================
app.base-url=http://localhost:8088/student9
app.frontend-url=http://localhost/student9

# ==================== 文件上传路径 ====================
file.upload.path=/home/student9/uploads9/
file.upload.allowed-extensions=pdf,jpg,jpeg,png

# ==================== OCR（百度智能云） ====================
ai.ocr.baidu.app-id=<YOUR_BAIDU_APP_ID>
ai.ocr.baidu.api-key=<YOUR_BAIDU_API_KEY>
ai.ocr.baidu.secret-key=<YOUR_BAIDU_SECRET_KEY>
ai.ocr.baidu.url=https://aip.baidubce.com/rest/2.0/ocr/v1/general_basic

# ==================== LLM（阿里云 DashScope） ====================
ai.llm.tywy.api-key=<YOUR_DASHSCOPE_API_KEY>
ai.llm.tywy.url=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
ai.llm.tywy.model=qwen-turbo
ai.llm.tywy.temperature=0.3
ai.llm.tywy.max-tokens=1000
ai.llm.tywy.timeout=30

# ==================== 日志 ====================
logging.level.com.jianlidb.resume=INFO
logging.level.root=INFO
logging.file.name=/home/student9/logs9/resume-system.log

# ==================== Jackson ====================
spring.jackson.date-format=yyyy-MM-dd HH:mm:ss
spring.jackson.time-zone=GMT+8
spring.jackson.default-property-inclusion=NON_NULL

java.io.tmpdir=/home/student9/tmp9/

# ==================== HikariCP ====================
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5
management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=always
